      "it": ["Aiutatemi, per favore!", "ah-yoo-TAH-teh-mee pehr fah-VOH-reh"],
      "fr": ["Aidez-moi, s’il vous plaît !", "eh-day MWAH seel voo PLEH"],
      "es": ["¡Ayúdeme, por favor!", "ah-YOO-deh-meh por fah-VOR"],
      "ja": ["助けてください！", "ta-su-ke-te kuh-da-sai"],
      "bn": ["দয়া করে সাহায্য করুন!", "do-ya ko-re shah-jjo ko-run"]
    }
  },
  "doctor": {
    "icon": "🩺",
    "group": "e",
    "tr": {
      "en": "I need a doctor.",
      "it": ["Ho bisogno di un medico.", "oh bee-ZOH-nyoh dee oon MEH-dee-koh"],
      "fr": ["J’ai besoin d’un médecin.", "zhay buh-ZWAN dun mayd-SAN"],
      "es": ["Necesito un médico.", "neh-seh-SEE-toh oon MEH-dee-koh"],
      "ja": ["医者が必要です。", "ee-sha ga hit-syoh des"],
