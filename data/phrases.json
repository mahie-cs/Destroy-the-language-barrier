      "fr": ["Où est l’hôpital ?", "oo eh loh-pee-TAHL"],
      "es": ["¿Dónde está el hospital?", "DOHN-deh es-TAH el os-pee-TAL"],
      "ja": ["病院はどこですか？", "byoh-in wa doh-ko des-ka"],
      "bn": ["হাসপাতাল কোথায়?", "haash-pa-taal ko-thaay"]
    }
  },
  "police": {
    "icon": "🚓",
    "group": "e",
    "tr": {
