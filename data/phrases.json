    }
  },
  "understand": {
    "icon": "🤷",
    "group": "c",
    "tr": {
      "en": "I don’t understand.",
      "it": ["Non capisco.", "nohn kah-PEE-skoh"],
      "fr": ["Je ne comprends pas.", "zhuh nuh kohm-PRAHN pah"],
      "es": ["No entiendo.", "noh en-tee-EN-doh"],
      "ja": ["わかりません。", "wa-ka-ree-ma-sen"],
      "bn": ["আমি বুঝতে পারছি না।", "aami bujh-te par-chi na"]
