      "fr": ["Comment vous appelez-vous ?", "koh-MAHN voo zah-puh-lay VOO"],
      "es": ["¿Cómo se llama?", "KOH-moh seh YAH-mah"],
      "ja": ["お名前は何ですか？", "oh-na-mae wa nan des-ka"],
      "bn": ["আপনার নাম কী?", "ap-nar naam ki"]
