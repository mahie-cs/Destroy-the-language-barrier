      "ja": ["トイレはどこですか？", "toy-reh wa doh-ko des-ka"],
      "bn": ["টয়লেট কোথায়?", "toy-let ko-thaay"]
    }
  },
  "water": {
    "icon": "💧",
    "group": "c",
    "tr": {
      "en": "Where can I get water?",
      "it": ["Dove posso trovare acqua?", "DOH-veh POHS-soh troh-VAH-reh AHK-kwah"],
      "fr": ["Où puis-je trouver de l’eau ?", "oo pwee-zhuh troo-VAY duh LOH"],
      "es": ["¿Dónde puedo conseguir agua?", "DOHN-deh PWEH-doh kon-seh-GEER AH-gwah"],
      "ja": ["水はどこで買えますか？", "mee-zoo wa doh-ko deh ka-e-mas-ka"],
